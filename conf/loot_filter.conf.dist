#
# mod-loot-filter configuration
#
# Automatic loot filtering — every looted item is checked against the
# character's rules (window: /lf) and kept, moved to the Endless
# Storage, sold, disenchanted or deleted. Quest items are never touched.
#

########################################
# General settings
########################################

#
#    LootFilter.Enable
#        Description: Enable the loot filter module
#        Default:     1 (Enabled)
#

LootFilter.Enable = 1

#
#    LootFilter.AllowSell
#        Description: Allow the Sell action (vendor price). When 0, rules with
#                     this action are skipped and the editor greys it out.
#        Default:     1 (Enabled)
#

LootFilter.AllowSell = 1

#
#    LootFilter.AllowDisenchant
#        Description: Allow the Disenchant action (no Enchanting skill needed;
#                     materials go to the Endless Storage). When 0, rules with
#                     this action are skipped.
#        Default:     1 (Enabled)
#

LootFilter.AllowDisenchant = 1

#
#    LootFilter.AllowDelete
#        Description: Allow the Delete action (destroys the item). When 0, rules
#                     with this action are skipped.
#        Default:     1 (Enabled)
#

LootFilter.AllowDelete = 1

#
#    LootFilter.LogActions
#        Description: Server-wide chat switch. 1 = each character's chat mode
#                     applies (every action / one summary per loot / none,
#                     set in the Log tab); 0 = no chat output at all.
#        Default:     1 (Enabled)
#

LootFilter.LogActions = 1

#
#    LootFilter.MaxRulesPerChar
#        Description: Maximum number of rules per character (1-100)
#        Default:     30
#

LootFilter.MaxRulesPerChar = 30
